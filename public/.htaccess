# ==============================================================================
# .htaccess Optimizado para ZWE Corporativa (Angular SPA + SEO + LiteSpeed/Apache)
# ==============================================================================

# 1. Forzar de forma exclusiva index.html (Angular SPA) y bloquear index.php
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 2. Asegurar HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 3. Servir archivos físicos directamente (robots.txt, sitemap.xml, css, js, imágenes)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Regla SPA: Redirigir cualquier ruta virtual de Angular hacia index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Tipos MIME explícitos para SEO
<IfModule mod_mime.c>
  AddType text/plain .txt
  AddType application/xml .xml
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType application/json .json
</IfModule>

# Cabeceras de tipo de contenido para robots y sitemap
<Files "robots.txt">
  <IfModule mod_headers.c>
    Header set Content-Type "text/plain; charset=utf-8"
    Header set X-Robots-Tag "all"
  </IfModule>
</Files>

<Files "sitemap.xml">
  <IfModule mod_headers.c>
    Header set Content-Type "application/xml; charset=utf-8"
    Header set X-Robots-Tag "noindex, follow"
  </IfModule>
</Files>

# Cabeceras de Seguridad
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Prevenir caché antiguo del navegador en index.html
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
  </FilesMatch>
</IfModule>

# Compresión GZIP / Deflate para máxima velocidad de carga (Core Web Vitals)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Caché en navegador para recursos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
